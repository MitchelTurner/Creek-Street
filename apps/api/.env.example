DATABASE_URL="postgresql://creek:creek@localhost:5432/creek_street?schema=public"
PORT=3001
# When unset or USE_MEMORY_STORE=true, the API serves Phase 0 seed data in-memory.
USE_MEMORY_STORE=true

# Phase 3 — official workflow (ALL required to unlock deliberation)
# Leave inactive until borough MOU/contract is executed.
PHASE3_CONTRACT_ACTIVE=false
PHASE3_CUSTODIAN=
PHASE3_PROCESSOR="Mitchel Turner Dev, LLC"
PHASE3_AGREEMENT_ID=
PHASE3_AGREEMENT_EFFECTIVE=
PHASE3_RETENTION_SCHEDULE_URL=
PHASE3_RECORDS_REQUEST_CONTACT=
PHASE3_OMA_NOTICE_INTEGRATION=false

# Phase 5 — ingest / workers
REDIS_URL=
CLERK_FEED_URL=
BOROUGH_GIS_URL=
KTNPORT_API_URL=

# Phase 7 — persistence / geo
# Set USE_MEMORY_STORE=false and DATABASE_URL to enable Prisma.
# Apply PostGIS helpers: npm run prisma:migrate -w @creek-street/api
# (migration enables creek_parcels_within_meters when postgis extension exists)
USE_POSTGIS=true

# Phase 8 — public origin for absolute sitemap locs (optional)
PUBLIC_WEB_ORIGIN=https://creek-street.example

# Phase 9 — delivery & ops
SMTP_URL=
SMTP_FROM="Creek Street Hub <noreply@creek-street.example>"
RATE_LIMIT_DISABLED=false
RATE_LIMIT_AUTH=20
RATE_LIMIT_SUBSCRIPTIONS=30
RATE_LIMIT_PHOTOS=15
